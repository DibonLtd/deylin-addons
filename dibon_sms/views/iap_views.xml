<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form View -->
    <record id="iap_account_view_form" model="ir.ui.view">
        <field name="name">iap.account.form</field>
        <field name="model">iap.account</field>
        <field name="type">form</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form string="SMS Provider">
                <header>
                    <button name="action_set_default" string="Set as Default Provider" type="object" 
                            class="oe_highlight" invisible="is_default_provider"/>
                    <button name="action_enable" string="Enable" type="object" 
                            class="oe_highlight" invisible="state == 'enabled'"
                            groups="base.group_system"/>
                    <button name="action_disable" string="Disable" type="object"
                            invisible="state != 'enabled'"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="enabled,disabled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Main Provider"/>
                        </h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-envelope">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle" readonly="1">
                            <field name="success_rate" widget="percentpie"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-paper-plane-o" readonly="1">
                            <field name="messages_sent" widget="statinfo" string="Sent"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-money" readonly="1">
                            <field name="total_cost" widget="statinfo" string="Cost"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-triangle" readonly="1">
                            <field name="failed_count" widget="statinfo" string="Failed"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <!-- service_id removed: avoid unresolved iap.service Many2one reads in some environments -->
                            <field name="is_default_provider" readonly="1"/>
                            <field name="sms_provider" required="1"/>
                            <field name="balance_string"/>
                            <field name="last_balance_update" string="Last Updated"/>
                        </group>
                        <group>
                            <field name="sms_secret" password="True"/>
                            <field name="sms_gateway"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1" placeholder="Add notes about this provider configuration..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="iap_account_view_tree" model="ir.ui.view">
        <field name="name">iap.account.tree</field>
        <field name="model">iap.account</field>
        <field name="type">tree</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <tree string="SMS Providers">
                <field name="name"/>
                <field name="sms_provider"/>
                <field name="balance_string"/>
                <field name="state"/>
                <field name="is_default_provider"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_dibon_sms_settings" model="ir.actions.act_window">
        <field name="name">SMS Settings</field>
        <field name="res_model">iap.account</field>
        <field name="view_mode">list,form</field>
        <!-- Use sms_provider-based domain to avoid related-field validation at view parse time -->
        <field name="domain">[('sms_provider','!=', False)]</field>
        <field name="context">{'no_breadcrumbs': True}</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first SMS provider configuration
            </p>
            <p>
                Configure your SMS providers and set one as default.
                You can have multiple providers configured for flexibility.
            </p>
        </field>
    </record>

    <!-- Tree View Definition -->
    <record id="action_dibon_sms_settings_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="iap_account_view_tree"/>
        <field name="act_window_id" ref="action_dibon_sms_settings"/>
    </record>

    <!-- Form View Definition -->
    <record id="action_dibon_sms_settings_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="iap_account_view_form"/>
        <field name="act_window_id" ref="action_dibon_sms_settings"/>
    </record>
<!-- SMS Message Views -->
    <record id="view_sms_sms_tree_dibon" model="ir.ui.view">
        <field name="name">sms.sms.tree.dibon</field>
        <field name="model">sms.sms</field>
        <field name="type">tree</field>
        <field name="priority">1100</field>
        <field name="arch" type="xml">
            <tree string="SMS Messages">
                <field name="id" invisible="1"/>
                <field name="number"/>
                <field name="partner_id" string="Contact"/>
                <field name="state" string="SMS Status"/>
                <field name="delivery_status" string="Delivery Status"/>
                <field name="gateway_status" string="Gateway SMS Status"/>
                <field name="sent_date"/>
            </tree>
        </field>
    </record>

    <record id="view_sms_sms_form_dibon" model="ir.ui.view">
        <field name="name">sms.sms.form.dibon</field>
        <field name="model">sms.sms</field>
        <field name="type">form</field>
        <field name="priority">1100</field>
        <field name="arch" type="xml">
            <form string="SMS Message">
                <sheet>
                    <group>
                        <field name="number"/>
                        <field name="state"/>
                        <field name="message_id"/>
                        <field name="delivery_status" readonly="1"/>
                        <field name="gateway_status" readonly="1"/>
                        <field name="gateway_code" readonly="1"/>
                        <field name="sent_date"/>
                    </group>
                    <notebook>
                        <page string="API Response">
                            <field name="api_response_pretty" readonly="1" widget="text"/>
                        </page>
                        <page string="Raw Response">
                            <field name="api_response" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dibon_sms_messages" model="ir.actions.act_window">
        <field name="name">Dibon SMS Messages</field>
        <field name="res_model">sms.sms</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sms_sms_tree_dibon"/>
    <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p>List of SMS messages sent via Dibon providers.</p>
        </field>
        <field name="target">current</field>
    </record>
    <record id="action_dibon_sms_messages_tree" model="ir.actions.act_window.view">
    <field name="sequence">1</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="view_sms_sms_tree_dibon"/>
    <field name="act_window_id" ref="action_dibon_sms_messages"/>
    </record>
    <record id="action_dibon_sms_messages_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sms_sms_form_dibon"/>
        <field name="act_window_id" ref="action_dibon_sms_messages"/>
    </record>
    <record id="view_dibon_sms_api_response_tree" model="ir.ui.view">
        <field name="name">dibon.sms_api_response.tree</field>
        <field name="model">dibon.sms_api_response</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="API Responses">
                <field name="id" invisible="1"/>
                <field name="sms_id"/>
                <field name="provider_id"/>
                <field name="status"/>
                <field name="status_code"/>
                <field name="created_at"/>
            </tree>
        </field>
    </record>

    <record id="view_dibon_sms_api_response_form" model="ir.ui.view">
        <field name="name">dibon.sms_api_response.form</field>
        <field name="model">dibon.sms_api_response</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="API Response">
                <sheet>
                    <group>
                        <field name="sms_id"/>
                        <field name="provider_id"/>
                        <field name="status"/>
                        <field name="status_code"/>
                        <field name="created_at"/>
                    </group>
                    <notebook>
                        <page string="Raw Response">
                            <field name="response_raw" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open the API Responses tree/form -->
    <record id="action_dibon_sms_api_responses" model="ir.actions.act_window">
        <field name="name">API Responses</field>
        <field name="res_model">dibon.sms_api_response</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_dibon_sms_api_response_tree"/>
        <field name="target">current</field>
    </record>

</odoo>
